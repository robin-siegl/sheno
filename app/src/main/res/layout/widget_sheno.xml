<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp" android:background="@drawable/widget_background">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sheno" android:textStyle="bold" android:textSize="16sp" android:textColor="@color/widget_text"/>
<TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Today" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/widget_text"/>
<TextView android:id="@+id/widget_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="16sp" android:maxLines="5" android:ellipsize="end" android:textColor="@color/widget_text"/>
</LinearLayout>
